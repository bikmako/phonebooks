{
  "name": "phonebooks",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PhoneBooks — бухгалтерия скупки смартфонов (восстановленный исходный проект React + Vite)",
  "scripts": {
    "predev": "node tools/prepare-scanner-assets.js",
    "dev": "vite",
    "prebuild": "node tools/prepare-scanner-assets.js",
    "build": "vite build",
    "prebuild:team": "node tools/prepare-scanner-assets.js --team",
    "build:team": "vite build --config vite.team.config.js",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "test:team": "playwright test --config playwright.team.config.js",
    "test:updates": "playwright test --config playwright.updates.config.js",
    "build:demo": "node tools/build-demo.js",
    "demo": "node server/demo-server.js",
    "test:demo": "playwright test --config playwright.demo.config.js"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "fflate": "0.8.3",
    "lucide-react": "0.454.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.4",
    "saxes": "6.0.0",
    "tesseract.js": "6.0.1",
    "tesseract.js-core": "6.1.2",
    "zxing-wasm": "3.1.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.6.0",
    "@playwright/test": "1.65.0",
    "@vitejs/plugin-react": "4.7.0",
    "bwip-js": "4.7.0",
    "embedded-postgres": "17.12.0-beta.19",
    "fake-indexeddb": "6.2.8",
    "vite": "6.4.6"
  }
}
