{
  "name": "phonebooks",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PhoneBooks — бухгалтерия скупки смартфонов (восстановленный исходный проект React + Vite)",
  "scripts": {
    "predev": "node tools/prepare-scanner-assets.js",
    "dev": "vite",
    "prebuild": "node tools/prepare-scanner-assets.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "test:updates": "playwright test --config playwright.updates.config.js",
    "build:accounts": "node tools/prepare-scanner-assets.js && node tools/build-accounts.js",
    "deploy:staging": "node tools/deploy-accounts-staging.js",
    "dev:accounts": "npm run build:accounts && wrangler dev --config wrangler.phonebooks.toml",
    "test:accounts": "playwright test --config playwright.accounts.config.js",
    "build:demo-registration": "node tools/build-demo-registration.js",
    "stand:accounts": "npm run build:accounts && node tests/support/accounts-stand.js"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "lucide-react": "0.454.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.4",
    "tesseract.js": "6.0.1",
    "tesseract.js-core": "6.1.2",
    "zxing-wasm": "3.1.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.6.0",
    "@playwright/test": "1.65.0",
    "@vitejs/plugin-react": "4.7.0",
    "bwip-js": "4.7.0",
    "fake-indexeddb": "6.2.8",
    "vite": "5.4.21",
    "wrangler": "4.167.0"
  }
}
